POSTGRES_HOST=127.0.0.1
POSTGRES_DB=shopping

/* Database Only for Testing & Should NEVER be Updated */
POSTGRES_TEST_DB = shopping_test

POSTGRES_USER=shopping_user
POSTGRES_PASSWORD=password123

/* Database will Most Likey be in Development Mode */
ENV=env

BCRYPT_PASSWORD=speak-friend-and-enter

/* Number of Times that Password will be Hashed */
SALT_ROUNDS=10

# Use a strong, random string
PASSWORD_PEPPER=a-very-long-and-random-string-1234!@#